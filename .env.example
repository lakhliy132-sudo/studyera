# Gabarit des variables d'environnement.
#
# Copiez ce fichier en `.env.local` (déjà ignoré par git, voir .gitignore)
# puis remplissez les deux valeurs ci-dessous depuis votre projet Supabase :
# Project Settings > API.
#
# Ces variables sont préfixées par NEXT_PUBLIC_ car elles sont utilisées
# par le client Supabase navigateur (lib/supabase/client.ts) : leur valeur
# est donc envoyée telle quelle au navigateur. Ce n'est pas un problème
# de sécurité ici : la clé "anon" est conçue pour être publique, la
# sécurité réelle des données repose sur les policies Supabase (RLS),
# pas sur le secret de cette clé.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé "service_role" : Project Settings > API > service_role.
# JAMAIS prefixee NEXT_PUBLIC_ : elle ne doit jamais atteindre le
# navigateur (elle contourne entierement RLS). Utilisee uniquement par
# scripts/importer.ts, execute en local, jamais par le code de l'app.
SUPABASE_SERVICE_ROLE_KEY=
